{
  "name": "dsh-better-classifier",
  "version": "0.2.1",
  "description": "DSH 的分层会话分类、自定义标签与树形搜索插件",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.2"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "@deepseek-ai/dsh-api-workspace-controller/client",
        "@deepseek-ai/dsh-api-session-controller/client"
      ]
    },
    "manifestVersion": 1
  },
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "README_ZH.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "icon.svg",
    "locale",
    "detail",
    "docs",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-file-drag": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-time": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.2",
    "@jridgewell/gen-mapping": "0.3.13",
    "@shikijs/langs": "^4.4.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "anser": "^2.3.5",
    "clsx": "2.1.1",
    "diff": "^9.0.0",
    "fflate": "0.8.3",
    "ignore-walk": "8.0.0",
    "immer": "^10.1.1",
    "jsdom": "29.1.1",
    "katex": "^0.18.7",
    "lightningcss": "1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "^4.4.3",
    "simple-icons": "16.31.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zustand": "~4.5.7"
  },
  "repository": {
    "url": "git+https://github.com/MakerFlyFly/DSH-better-classifier.git",
    "type": "git"
  },
  "homepage": "https://github.com/MakerFlyFly/DSH-better-classifier#readme",
  "bugs": {
    "url": "https://github.com/MakerFlyFly/DSH-better-classifier/issues"
  },
  "author": "MakerFly",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sessions",
    "folders",
    "tags"
  ],
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json && tsc -p tsconfig.tests-host.json && tsc -p tsconfig.tests-client.json",
    "verify": "node scripts/verify.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run"
  }
}
